FROM rust:1.85-slim-bookworm AS qart-builder

ARG QART_COMMIT=6e0e00804a1994db7098432c19fadfc552071e30
RUN apt-get update \
    && apt-get install -y --no-install-recommends git pkg-config \
    && git clone https://github.com/andrewyur/qart.git /src/qart \
    && git -C /src/qart checkout "$QART_COMMIT" \
    && test "$(git -C /src/qart rev-parse HEAD)" = "$QART_COMMIT" \
    && cargo build --manifest-path /src/qart/Cargo.toml --release --locked

FROM node:22.15.0-bookworm-slim AS qr-verify-builder

WORKDIR /opt/prooftag-qr-verify
COPY qr_verify_bridge/package.json qr_verify_bridge/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false --audit=false
COPY qr_verify_bridge/bridge.mjs ./bridge.mjs

FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

ARG DIFFQRCODER_COMMIT=e24ea73ee2e13c7e6e87cb422e8b11784e70ae00
ARG QART_COMMIT=6e0e00804a1994db7098432c19fadfc552071e30
ARG EXPECTED_NOTEBOOK=notebooks/21_e026_prompt_parameter_advisor.ipynb
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch \
    PROOFTAG_QR_QR_VERIFY_BRIDGE=/opt/prooftag-qr-verify/bridge.mjs \
    PROOFTAG_QR_NODE_EXECUTABLE=/usr/local/bin/node

USER root
COPY --from=qart-builder /src/qart/target/release/qart /usr/local/bin/qart
COPY --from=qart-builder /src/qart/LICENSE /opt/licenses/qart-LICENSE
COPY --from=qr-verify-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=qr-verify-builder /opt/prooftag-qr-verify /opt/prooftag-qr-verify
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git libgl1 libglib2.0-0 libzbar0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY prooftag_qr ./prooftag_qr
RUN pip install --upgrade pip \
    && pip install '.[notebook,optimizer]' \
    && pip install \
        accelerate==1.3.0 \
        diffusers==0.32.2 \
        lpips==0.1.4 \
        tqdm==4.67.1 \
        transformers==4.48.3 \
        torchvision==0.21.0

RUN qart help >/dev/null \
    && node -e "const p=require('/opt/prooftag-qr-verify/node_modules/qr-verify/package.json'); if(p.version!=='0.2.0') process.exit(1); console.log('qr-verify version OK:', p.version)" \
    && python -c "import importlib.metadata, sentencepiece, zxingcpp, kornia; from google.protobuf import __version__ as protobuf_version; from prooftag_qr.qr import generate_diffqrcoder_qr; from prooftag_qr.validation import QRVerifyDecoder; p='https://ptag.io/t/notebook-build'; d=QRVerifyDecoder(); a=d.decode_presets(generate_diffqrcoder_qr(p).image); d.close(); assert len(a)==37 and all(x['text']==p for x in a); print('Notebook dependency stack and qr-verify OK:', '$QART_COMMIT', importlib.metadata.version('zxing-cpp'), kornia.__version__, sentencepiece.__version__, protobuf_version)"

RUN git clone https://github.com/jwliao1209/DiffQRCoder.git /opt/DiffQRCoder \
    && git -C /opt/DiffQRCoder checkout "$DIFFQRCODER_COMMIT" \
    && test "$(git -C /opt/DiffQRCoder rev-parse HEAD)" = "$DIFFQRCODER_COMMIT" \
    && rm -rf /opt/DiffQRCoder/.git \
    && python -c "import sys; sys.path.insert(0, '/opt/DiffQRCoder'); from diffqrcoder import DiffQRCoderPipeline; import torch, torchvision, diffusers; print('DiffQRCoder stack OK:', torch.__version__, torchvision.__version__, diffusers.__version__)"

# SR-MPGD doit fonctionner même sans téléchargement au milieu d'une longue campagne.
RUN python -c "import lpips; lpips.LPIPS(net='vgg', verbose=False); print('LPIPS VGG cache OK')"

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /data /cache /workspace /cache/torch \
    && chown -R app:app /app /data /cache /workspace

WORKDIR /workspace
COPY notebooks /workspace/notebooks
RUN test -f "/workspace/${EXPECTED_NOTEBOOK}" \
    && echo "Notebook present in image: /workspace/${EXPECTED_NOTEBOOK}" \
    && mkdir -p /workspace/results /data/notebook-runs /data/parameter-search \
    && chown -R app:app /workspace /data/notebook-runs /data/parameter-search

USER app
EXPOSE 8888

CMD ["python", "-m", "jupyterlab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--ServerApp.root_dir=/workspace"]
