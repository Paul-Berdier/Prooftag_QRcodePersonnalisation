ARG BASE_IMAGE=prooftag-qr:dev
FROM ${BASE_IMAGE}

USER root
WORKDIR /workspace
COPY notebooks /workspace/notebooks
RUN pip install --no-cache-dir "jupyterlab>=4.2,<5" "matplotlib>=3.9,<4" \
    && mkdir -p /workspace/results /data/notebook-runs \
    && chown -R app:app /workspace /data/notebook-runs

USER app
EXPOSE 8888

CMD ["python", "-m", "jupyterlab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--ServerApp.root_dir=/workspace"]
