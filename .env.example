PROOFTAG_QR_ENVIRONMENT=development
PROOFTAG_QR_LOG_LEVEL=INFO
PROOFTAG_QR_DATA_DIR=/data
PROOFTAG_QR_MODEL_CACHE_DIR=/cache
PROOFTAG_QR_DEFAULT_BACKEND=qr
PROOFTAG_QR_BASE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
PROOFTAG_QR_CONTROLNET_MODEL_ID=DionTimmer/controlnet_qrcode-control_v1p_sd15
PROOFTAG_QR_DEVICE=cuda
PROOFTAG_QR_VALIDATION_MIN_PASS_RATE=1.0
PROOFTAG_QR_MAX_ATTEMPTS=3
PROOFTAG_QR_DATABASE_BACKEND=sqlite
# Production Kubernetes injects PROOFTAG_QR_DATABASE_PASSWORD from a Secret.
PROOFTAG_QR_DATABASE_HOST=prooftag-qr-postgres
PROOFTAG_QR_DATABASE_PORT=5432
PROOFTAG_QR_DATABASE_NAME=prooftag_qr
PROOFTAG_QR_DATABASE_USER=prooftag_qr
PROOFTAG_QR_DATABASE_PASSWORD=
PROOFTAG_QR_DATABASE_URL_OVERRIDE=
PROOFTAG_QR_ARTIFACT_STORE=local
PROOFTAG_QR_S3_ENDPOINT=http://minio.data-core.svc.cluster.local:9000
PROOFTAG_QR_S3_BUCKET=prooftag-qr
PROOFTAG_QR_S3_ACCESS_KEY=
PROOFTAG_QR_S3_SECRET_KEY=
