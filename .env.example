PROOFTAG_QR_ENVIRONMENT=development
PROOFTAG_QR_LOG_LEVEL=INFO
PROOFTAG_QR_DATA_DIR=/data
PROOFTAG_QR_MODEL_CACHE_DIR=/cache
PROOFTAG_QR_DEFAULT_BACKEND=qr
PROOFTAG_QR_BASE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
PROOFTAG_QR_CONTROLNET_MODEL_ID=DionTimmer/controlnet_qrcode-control_v1p_sd15
PROOFTAG_QR_CONTROLNET_PIPELINE_MODE=img2img
PROOFTAG_QR_DEVICE=cuda
PROOFTAG_QR_VALIDATION_MIN_PASS_RATE=1.0
PROOFTAG_QR_MAX_ATTEMPTS=3
PROOFTAG_QR_REGENERATE_BEFORE_GLOBAL_REPAIR=true
# Stage 2 inspired by DiffQRCoder. Keep disabled outside an identified benchmark.
PROOFTAG_QR_GUIDED_REDIFFUSION_ENABLED=false
PROOFTAG_QR_GUIDED_REDIFFUSION_STEPS=8
PROOFTAG_QR_GUIDED_REDIFFUSION_STRENGTH=0.30
PROOFTAG_QR_GUIDED_REDIFFUSION_CONTROLNET_SCALE=1.75
PROOFTAG_QR_GUIDED_REDIFFUSION_GUIDE_CENTER_SCALE=0.45
PROOFTAG_QR_GUIDED_REDIFFUSION_GUIDE_CONFIDENCE_MARGIN=16.0
PROOFTAG_QR_GUIDED_REDIFFUSION_MASK_DILATION_PX=4
PROOFTAG_QR_GUIDED_REDIFFUSION_MASK_FEATHER_PX=4
PROOFTAG_QR_GUIDED_REDIFFUSION_MAX_MEAN_ABSOLUTE_CHANGE=0.12
PROOFTAG_QR_GUIDED_REDIFFUSION_MIN_RELATIVE_MODULE_IMPROVEMENT=0.01
PROOFTAG_QR_GUIDED_REDIFFUSION_SEED_OFFSET=1000003
# E005: true SRPG guidance inside the DDIM loop. Experimental and disabled by default.
PROOFTAG_QR_SRPG_ENABLED=false
PROOFTAG_QR_SRPG_STEPS=40
PROOFTAG_QR_SRPG_STRENGTH=1.0
PROOFTAG_QR_SRPG_CONTROLNET_SCALE=1.35
PROOFTAG_QR_SRPG_QR_WEIGHT=500.0
PROOFTAG_QR_SRPG_PERCEPTUAL_WEIGHT=3.0
PROOFTAG_QR_SRPG_FUNCTIONAL_WEIGHT=4.0
PROOFTAG_QR_SRPG_CENTER_FRACTION=0.3333333333
# 0.50/0.50 conserve E005. Le profil officiel teste en E006 utilise 0.45/0.65.
PROOFTAG_QR_SRPG_DARK_THRESHOLD=0.50
PROOFTAG_QR_SRPG_LIGHT_THRESHOLD=0.50
PROOFTAG_QR_SRPG_ROBUST_BLUR_WEIGHT=0.0
PROOFTAG_QR_SRPG_ROBUST_BLUR_KERNEL=3
PROOFTAG_QR_SRPG_ROBUST_DOWNSCALE_WEIGHT=0.0
PROOFTAG_QR_SRPG_ROBUST_DOWNSCALE_FACTOR=0.75
PROOFTAG_QR_SRPG_ROBUST_BRIGHTNESS_WEIGHT=0.0
PROOFTAG_QR_SRPG_ROBUST_BRIGHTNESS_LOW=0.75
PROOFTAG_QR_SRPG_ROBUST_BRIGHTNESS_HIGH=1.25
PROOFTAG_QR_SRPG_ROBUST_CONTRAST_WEIGHT=0.0
PROOFTAG_QR_SRPG_ROBUST_CONTRAST_FACTOR=0.70
PROOFTAG_QR_SRPG_TARGET_MODULE_ERROR_RATE=0.0
PROOFTAG_QR_SRPG_MAX_NOISE_DELTA_RMS=2.0
PROOFTAG_QR_SRPG_ETA=0.0
PROOFTAG_QR_SRPG_MAX_MEAN_ABSOLUTE_CHANGE=0.20
PROOFTAG_QR_SRPG_MIN_RELATIVE_MODULE_IMPROVEMENT=0.10
PROOFTAG_QR_SRPG_SEED_OFFSET=2000003
PROOFTAG_QR_SRPG_SAVE_STEP_PREVIEWS=false
PROOFTAG_QR_SRPG_PREVIEW_INTERVAL=5
# Experimental and disabled until the GPU benchmark has established safe parameters.
PROOFTAG_QR_LATENT_REFINEMENT_ENABLED=false
PROOFTAG_QR_LATENT_REFINEMENT_ITERATIONS=8
PROOFTAG_QR_LATENT_REFINEMENT_LEARNING_RATE=0.02
PROOFTAG_QR_LATENT_REFINEMENT_QR_WEIGHT=1.0
PROOFTAG_QR_LATENT_REFINEMENT_PRESERVATION_WEIGHT=1.0
PROOFTAG_QR_LATENT_REFINEMENT_FUNCTIONAL_WEIGHT=4.0
PROOFTAG_QR_LATENT_REFINEMENT_TARGET_MODULE_ERROR_RATE=0.0
PROOFTAG_QR_LATENT_REFINEMENT_MAX_LATENT_DELTA=0.10
PROOFTAG_QR_LATENT_REFINEMENT_MAX_MEAN_ABSOLUTE_CHANGE=0.08
PROOFTAG_QR_LATENT_REFINEMENT_MIN_RELATIVE_MODULE_IMPROVEMENT=0.01
PROOFTAG_QR_SAVE_DEBUG_ARTIFACTS=false
PROOFTAG_QR_DATABASE_BACKEND=sqlite
# Production Kubernetes injects PROOFTAG_QR_DATABASE_PASSWORD from a Secret.
PROOFTAG_QR_DATABASE_HOST=prooftag-qr-postgres
PROOFTAG_QR_DATABASE_PORT=5432
PROOFTAG_QR_DATABASE_NAME=prooftag_qr
PROOFTAG_QR_DATABASE_USER=prooftag_qr
PROOFTAG_QR_DATABASE_PASSWORD=
PROOFTAG_QR_DATABASE_URL_OVERRIDE=
PROOFTAG_QR_ARTIFACT_STORE=local
PROOFTAG_QR_S3_ENDPOINT=http://minio.data-core.svc.cluster.local:9000
PROOFTAG_QR_S3_BUCKET=prooftag-qr
PROOFTAG_QR_S3_ACCESS_KEY=
PROOFTAG_QR_S3_SECRET_KEY=
